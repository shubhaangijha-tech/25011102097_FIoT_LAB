
[
    {
        "id": "tab_bme",
        "type": "tab",
        "label": "STM32 BME280 Monitoring",
        "disabled": false,
        "info": "BME280 HTTP monitoring using STM32 and ESP8266"
    },
    {
        "id": "inject_bme",
        "type": "inject",
        "z": "tab_bme",
        "name": "Read Sensor Data",
        "props": [{"p": "payload"}],
        "repeat": "2",
        "once": true,
        "onceDelay": "1",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 160,
        "wires": [["http_bme"]]
    },
    {
        "id": "http_bme",
        "type": "http request",
        "z": "tab_bme",
        "name": "Get BME280 Data",
        "method": "GET",
        "ret": "txt",
        "paytoqs": "ignore",
        "url": "http://192.168.1.105/",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 360,
        "y": 160,
        "wires": [["json_bme"]]
    },
    {
        "id": "json_bme",
        "type": "json",
        "z": "tab_bme",
        "name": "Parse JSON",
        "property": "payload",
        "action": "",
        "pretty": false,
        "x": 550,
        "y": 160,
        "wires": [["function_bme", "debug_bme"]]
    },
    {
        "id": "function_bme",
        "type": "function",
        "z": "tab_bme",
        "name": "Extract Sensor Values",
        "func": "if (msg.payload.status !== 'success') {\n    node.warn('Sensor data unavailable');\n    return null;\n}\n\nvar temperature = Number(msg.payload.temperature);\nvar humidity = Number(msg.payload.humidity);\nvar pressure = Number(msg.payload.pressure);\n\nif (!Number.isFinite(temperature) || !Number.isFinite(humidity) || !Number.isFinite(pressure)) {\n    node.warn('Invalid sensor values');\n    return null;\n}\n\nvar tempMsg = {payload: temperature, topic: 'Temperature'};\nvar humMsg = {payload: humidity, topic: 'Humidity'};\nvar pressMsg = {payload: pressure, topic: 'Pressure'};\n\nreturn [tempMsg, humMsg, pressMsg];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 160,
        "wires": [
            ["temp_gauge", "temp_chart"],
            ["hum_gauge", "hum_chart"],
            ["press_gauge", "press_chart"]
        ]
    },
    {
        "id": "temp_gauge",
        "type": "ui_gauge",
        "z": "tab_bme",
        "name": "Temperature Gauge",
        "group": "bme_group",
        "order": 1,
        "width": 4,
        "height": 4,
        "gtype": "gage",
        "title": "Temperature",
        "label": "°C",
        "format": "{{value}}",
        "min": 0,
        "max": 50,
        "colors": ["#00b500", "#e6e600", "#ca3838"],
