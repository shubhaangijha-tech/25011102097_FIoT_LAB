    {
        "id": "632c51e41024e002",
        "type": "function",
        "z": "ddb4dedd8ec0da2a",
        "name": "format data",
        "func": "\nlet owm = msg.payload;\n\nmsg.payload = {\n    source: \"openweather\",\n    temperature: owm.main.temp,\n    pressure: owm.main.pressure,\n    humidity: owm.main.humidity,\n    city: owm.name,\n    condition: owm.weather[0].main,\n    description: owm.weather[0].description,\n    wind: owm.wind ? owm.wind.speed : 0\n};\n\nflow.set(\"weather\", msg.payload);\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
