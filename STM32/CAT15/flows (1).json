    {
        "id": "a045a8c12ad26ce1",
        "type": "ui-template",
        "z": "ddb4dedd8ec0da2a",
        "group": "9342d3dcf7425c4d",
        "page": "",
        "ui": "",
        "name": "Outdoor Activity",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div v-if=\"msg && msg.payload\" style=\"padding:15px\">\n\n    <h2>Weather Comparison</h2>\n    <h3>{{msg.payload.city}}</h3>\n\n    <div class=\"weather-grid\">\n\n      <!-- BME280 SENSOR -->\n      <div class=\"weather-box\">\n        <h3>BME280 SENSOR</h3>\n        <h1>{{msg.payload.bme280.temperature}} °C</h1>\n        \n        <!-- Temperature Gauge / Bar -->\n        <div class=\"gauge-container\">\n          <div class=\"gauge-label\"><span>Temp Range</span><span>{{msg.payload.bme280.temperature}}°C</span></div>\n          <div class=\"progress-bar\">\n            <div class=\"progress-fill temp-fill\" :style=\"{ width: Math.min(Math.max((msg.payload.bme280.temperature / 50) * 100, 0), 100) + '%' }\"></div>\n          </div>\n        </div>\n\n        <p>Pressure: {{msg.payload.bme280.pressure}} hPa</p>\n        <!-- Pressure Bar -->\n        <div class=\"gauge-container\">\n          <div class=\"gauge-label\"><span>Pressure</span><span>{{msg.payload.bme280.pressure}} hPa</span></div>\n          <div class=\"progress-bar\">\n            <div class=\"progress-fill press-fill\" :style=\"{ width: Math.min(Math.max(((msg.payload.bme280.pressure - 900) / 200) * 100, 0), 100) + '%' }\"></div>\n          </div>\n        </div>\n\n        <p>Humidity: {{msg.payload.bme280.humidity}}%</p>\n        <!-- Humidity Bar / Gauge -->\n        <div class=\"gauge-container\">\n          <div class=\"gauge-label\"><span>Humidity</span><span>{{msg.payload.bme280.humidity}}%</span></div>\n          <div class=\"progress-bar\">\n            <div class=\"progress-fill hum-fill\" :style=\"{ width: Math.min(Math.max(msg.payload.bme280.humidity, 0), 100) + '%' }\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- OPENWEATHERMAP -->\n      <div class=\"weather-box\">\n        <h3>OPENWEATHERMAP</h3>\n        <h1>{{msg.payload.openweathermap.temperature}} °C</h1>\n\n        <!-- Temperature Gauge / Bar -->\n        <div class=\"gauge-container\">\n          <div class=\"gauge-label\"><span>Temp Range</span><span>{{msg.payload.openweathermap.temperature}}°C</span></div>\n          <div class=\"progress-bar\">\n            <div class=\"progress-fill temp-fill\" :style=\"{ width: Math.min(Math.max((msg.payload.openweathermap.temperature / 50) * 100, 0), 100) + '%' }\"></div>\n          </div>\n        </div>\n\n        <p>Pressure: {{msg.payload.openweathermap.pressure}} hPa</p>\n        <div class=\"gauge-container\">\n          <div class=\"gauge-label\"><span>Pressure</span><span>{{msg.payload.openweathermap.pressure}} hPa</span></div>\n          <div class=\"progress-bar\">\n            <div class=\"progress-fill press-fill\" :style=\"{ width: Math.min(Math.max(((msg.payload.openweathermap.pressure - 900) / 200) * 100, 0), 100) + '%' }\"></div>\n          </div>\n        </div>\n\n        <p>Humidity: {{msg.payload.openweathermap.humidity}}%</p>\n        <div class=\"gauge-container\">\n          <div class=\"gauge-label\"><span>Humidity</span><span>{{msg.payload.openweathermap.humidity}}%</span></div>\n          <div class=\"progress-bar\">\n            <div class=\"progress-fill hum-fill\" :style=\"{ width: Math.min(Math.max(msg.payload.openweathermap.humidity, 0), 100) + '%' }\"></div>\n          </div>\n        </div>\n\n        <p>{{msg.payload.openweathermap.description}}</p>\n        <p>Wind: {{msg.payload.openweathermap.wind}} m/s</p>\n      </div>\n\n    </div>\n\n    <h3>READING DIFFERENCES</h3>\n\n    <div class=\"weather-box\">\n      <p>Temperature difference: <strong>{{msg.payload.comparison.temperatureDifference}} °C</strong></p>\n      <p>Humidity difference: <strong>{{msg.payload.comparison.humidityDifference}}%</strong></p>\n    </div>\n\n    <div class=\"recommendation\"\n      :style=\"{backgroundColor:\n        msg.payload.recommendation === 'GOOD' ? '#219653' :\n        msg.payload.recommendation === 'WORSE' ? '#e6a23c' : '#d93025'}\">\n\n      <h2>OUTDOOR ACTIVITY</h2>\n      <h1>{{msg.payload.recommendation}}</h1>\n      <p>{{msg.payload.advice}}</p>\n\n    </div>\n\n  </div>\n</template>\n\n<style>\n.weather-grid {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.weather-box {\n  flex: 1;\n  min-width: 260px;\n  padding: 18px;\n  margin-bottom: 12px;\n  border-radius: 10px;\n  background: #e8f1ff;\n  color: #183b65;\n}\n\n/* Gauge / Progress Bar Styles */\n.gauge-container {\n  margin: 10px 0 15px 0;\n}\n\n.gauge-label {\n  display: flex;\n  justify-content: space-between;\n  font-size: 12px;\n  font-weight: bold;\n  margin-bottom: 4px;\n  color: #334e68;\n}\n\n.progress-bar {\n  width: 100%;\n  height: 10px;\n  background-color: #cbd5e1;\n  border-radius: 5px;\n  overflow: hidden;\n}\n\n.progress-fill {\n  height: 100%;\n  transition: width 0.4s ease-in-out;\n  border-radius: 5px;\n}\n\n.temp-fill {\n  background-color: #f59e0b; /* Orange for temperature */\n}\n\n.press-fill {\n  background-color: #3b82f6; /* Blue for pressure */\n}\n\n.hum-fill {\n  background-color: #10b981; /* Green for humidity */\n}\n\n.recommendation {\n  padding: 20px;\n  margin-top: 15px;\n  border-radius: 12px;\n  text-align: center;\n  color: white;\n}\n\n.recommendation h1 {\n  font-size: 36px;\n  margin: 10px 0;\n}\n</style>",
        "storeOutMessages": true,
