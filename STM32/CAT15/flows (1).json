    {
        "id": "78b45a291ed7e127",
        "type": "function",
        "z": "ddb4dedd8ec0da2a",
        "name": "bme_parser",
        "func": "// Ensure payload exists to prevent crashes\nif (!msg.payload) {\n    msg.payload = { temperature: 25, pressure: 1013, humidity: 50 };\n    return msg;\n}\n\nlet data = msg.payload;\n\n// Handle stringified JSON if necessary\nif (typeof data === 'string') {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        // Fallback if JSON parse fails\n    }\n}\n\n// Safely extract values with default fallbacks\nlet t = (data && data.temperature !== undefined) ? data.temperature : (data && data.temp !== undefined ? data.temp : 25);\nlet p = (data && data.pressure !== undefined) ? data.pressure : 1013;\nlet h = (data && data.humidity !== undefined) ? data.humidity : 50;\n\n// Output standardized clean numbers\nmsg.payload = {\n    temperature: Number(t),\n    pressure: Number(p),\n    humidity: Number(h)\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 120,
        "wires": [
            [
                "f61216b3156c4447"
            ]
        ]
    },
    {
        "id": "f61216b3156c4447",
        "type": "function",
        "z": "ddb4dedd8ec0da2a",
        "name": "Compare and Recommend",
        "func": "// Retrieve or initialize cache to store both data sources\nlet cache = flow.get('weather_cache') || {\n    bme280: { temperature: 25, pressure: 1013, humidity: 50 },\n    openweathermap: { temperature: 24, pressure: 1012, humidity: 55, description: \"Clear sky\", wind: 2.1 },\n    city: \"Local Station\"\n};\n\nlet payload = msg.payload || {};\n\n// Identify if incoming message is from BME280 parser or OpenWeatherMap\nif (payload.temperature !== undefined && payload.description === undefined) {\n    cache.bme280 = {\n        temperature: Number(payload.temperature),\n        pressure: Number(payload.pressure || 1013),\n        humidity: Number(payload.humidity || 50)\n    };\n} else if (payload.temperature !== undefined || payload.main || payload.weather) {\n    cache.openweathermap = {\n        temperature: Number(payload.temperature !== undefined ? payload.temperature : (payload.main ? payload.main.temp : 24)),\n        pressure: Number(payload.pressure !== undefined ? payload.pressure : (payload.main ? payload.main.pressure : 1012)),\n        humidity: Number(payload.humidity !== undefined ? payload.humidity : (payload.main ? payload.main.humidity : 55)),\n        description: payload.description || (payload.weather ? payload.weather[0].description : \"Clear sky\"),\n        wind: Number(payload.wind !== undefined ? payload.wind : (payload.wind_speed || 2.1))\n    };\n    if (payload.city) cache.city = payload.city;\n}\n\n// Save back to flow context\nflow.set('weather_cache', cache);\n\nlet bme = cache.bme280;\nlet owm = cache.openweathermap;\n\n// Calculate differences\nlet tempDiff = +(bme.temperature - owm.temperature).toFixed(1);\nlet humDiff = +(bme.humidity - owm.humidity).toFixed(1);\n\n// Primary evaluation: If temperature is between 20°C and 35°C, it's a GO!\nlet recommendation = \"GOOD\";\nlet advice = \"ATHLETIC MEET GO AHEAD\";\n\nif (bme.temperature < 20 || bme.temperature > 26) {\n    // Out of comfortable range -> Postpone\n    recommendation = \"BAD\";\n    advice = \"POSTPONE THE MEET\";\n} else if (Math.abs(tempDiff) > 10 || bme.humidity > 95) {\n    // Extreme variance or extreme moisture warning\n    recommendation = \"NOT SUITABLE\";\n    advice = \"TAKE PRECAUTION AND LIKELY ADVISED NOT TO CONDUCT THE MEET\";\n}\n\n// Construct exact payload for your Vue template\nmsg.payload = {\n    city: cache.city,\n    bme280: bme,\n    openweathermap: owm,\n    comparison: {\n        temperatureDifference: tempDiff,\n        humidityDifference: humDiff\n    },\n    recommendation: recommendation,\n    advice: advice\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 140,
